---
// Icons from Lucide (lucide.dev), ISC License, inlined at build time.
import icons from '../data/icons.json';

interface Props { name: keyof typeof icons; size?: number; class?: string }
const { name, size = 24, class: className } = Astro.props;
---
<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
