---
// Compact tire size picker: shows diameter and sidewall instantly and links to the size page or the calculator.
import catalog from '../data/tires/common.json';
const cat = catalog as [number, number, number][];
const widths = [...new Set(cat.map((s) => s[0]))].sort((a, b) => a - b);
const aspects = [...new Set(cat.map((s) => s[1]))].sort((a, b) => a - b);
const rims = [...new Set(cat.map((s) => s[2]))].sort((a, b) => a - b);
---
<div class="tp" data-tire-picker>
  <p class="tp-label">Medida de tu llanta</p>
  <div class="tp-row">
    <select name="w" aria-label="Ancho">{widths.map((v) => <option value={v} selected={v === 205}>{v}</option>)}</select>
    <span>/</span>
    <select name="a" aria-label="Perfil">{aspects.map((v) => <option value={v} selected={v === 55}>{v}</option>)}</select>
    <span>R</span>
    <select name="r" aria-label="Rin">{rims.map((v) => <option value={v} selected={v === 16}>{v}</option>)}</select>
  </div>
  <p class="tp-out" aria-live="polite"><span data-out>Diámetro 632 mm · flanco 113 mm</span> <a data-go href="/llantas/205-55-r16/">Ver medida →</a></p>
</div>

<script>
  import { dimensions, sizeSlug } from '../lib/tires.js';
  import { fmt } from '../lib/format.js';
  import published from '../data/tires/published.json';
  document.querySelectorAll<HTMLElement>('[data-tire-picker]').forEach((root) => {
    const get = (n: string) => Number(root.querySelector<HTMLSelectElement>(`select[name="${n}"]`)!.value);
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const go = root.querySelector<HTMLAnchorElement>('[data-go]')!;
    const update = () => {
      const s = { width: get('w'), aspect: get('a'), rim: get('r') };
      const d = dimensions(s);
      out.textContent = `Diámetro ${fmt(d.diameter, 0)} mm · flanco ${fmt(d.sidewall, 0)} mm`;
      const slug = sizeSlug(s);
      go.href = published.includes(slug) ? `/llantas/${slug}/` : `/herramientas/equivalencia-de-llantas/?de=${slug}`;
      go.textContent = published.includes(slug) ? 'Ver medida →' : 'Ver equivalencias →';
    };
    root.addEventListener('change', update);
    update();
  });
</script>

<style>
  .tp { padding: 1rem 1.1rem; border-radius: var(--radius); background: rgb(255 255 255 / 7%); border: 1px solid rgb(255 255 255 / 12%); color: #fff; }
  .tp-label { font-weight: 700; margin: 0 0 0.45rem; }
  .tp-row { display: flex; align-items: center; gap: 0.35rem; }
  .tp-row span { color: #c3cfdd; font-weight: 700; }
  .tp select { flex: 1; min-width: 0; min-height: 3rem; padding: 0 0.4rem; border: 0; border-radius: 10px; font: 700 1.15rem system-ui, sans-serif; color: var(--ink); background: #fff; }
  .tp-out { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; margin: 0.6rem 0 0; font-size: 0.95rem; color: #e3eaf3; }
  .tp-out a { color: var(--amber-bright); font-weight: 700; text-decoration: none; }
</style>
