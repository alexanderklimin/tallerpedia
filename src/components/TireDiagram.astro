---
// Scale drawing of a tire with named dimensions: side view (overall diameter, rim, sidewall band)
// and a cut through the tire (width and sidewall height). Both views use the same scale.
import { dimensions, sizeLabel } from '../lib/tires.js';
import { fmt } from '../lib/format.js';

interface Props { size: { width: number; aspect: number; rim: number } }
const { size } = Astro.props;
const d = dimensions(size);
const scale = 180 / d.diameter;
const R = 90;
const r = (d.rimMm / 2) * scale;
const mid = (R + r) / 2;
const cx = 150, cy = 118;
const ang = (-50 * Math.PI) / 180;
const px = cx + mid * Math.cos(ang), py = cy + mid * Math.sin(ang);
// cut
const w = size.width * scale;
const h = d.sidewall * scale;
const sx = 58 - w / 2, sy = 70;
---
<figure class="td">
  <div class="views">
    <svg viewBox="0 0 280 262" role="img" aria-label={`Vista lateral de la llanta ${sizeLabel(size)}: diámetro total ${fmt(d.diameter, 0)} mm, rin ${size.rim} pulgadas, flanco ${fmt(d.sidewall)} mm`}>
      <text class="title" x="150" y="14" text-anchor="middle">Vista lateral</text>
      <g class="spin" style={`transform-origin:${cx}px ${cy}px`}>
        <circle cx={cx} cy={cy} r={R} fill="#1d232c" />
        <circle cx={cx} cy={cy} r={mid} fill="none" stroke="#f5a524" stroke-opacity="0.4" stroke-width={R - r - 4} />
        {Array.from({ length: 36 }, (_, i) => i * 10).map((a) => (
          <line x1={cx} y1={cy - R} x2={cx} y2={cy - R + 6} stroke="#3a4554" stroke-width="3" transform={`rotate(${a} ${cx} ${cy})`} />
        ))}
        <circle cx={cx} cy={cy} r={r} fill="#d5dde7" stroke="#8fa0b5" stroke-width="2" />
        {[0, 72, 144, 216, 288].map((a) => (
          <line x1={cx} y1={cy} x2={cx} y2={cy - r * 0.85} stroke="#b4c1cf" stroke-width={r * 0.2} stroke-linecap="round" transform={`rotate(${a} ${cx} ${cy})`} />
        ))}
        <circle cx={cx} cy={cy} r={r * 0.22} fill="#6d7e93" />
      </g>
      <g class="dim blue">
        <line x1={cx - R - 14} y1={cy - R} x2={cx - R - 14} y2={cy + R} />
        <line x1={cx - R - 20} y1={cy - R} x2={cx - R - 8} y2={cy - R} />
        <line x1={cx - R - 20} y1={cy + R} x2={cx - R - 8} y2={cy + R} />
        <text x={cx - R - 22} y={cy} transform={`rotate(-90 ${cx - R - 22} ${cy})`} text-anchor="middle"><tspan class="lbl">Diámetro total</tspan> {fmt(d.diameter, 0)} mm</text>
      </g>
      <g class="dim grey">
        <line x1={cx - r} y1={cy + R + 14} x2={cx + r} y2={cy + R + 14} />
        <line x1={cx - r} y1={cy + R + 8} x2={cx - r} y2={cy + R + 20} />
        <line x1={cx + r} y1={cy + R + 8} x2={cx + r} y2={cy + R + 20} />
        <line x1={cx - r} y1={cy} x2={cx - r} y2={cy + R + 14} stroke-dasharray="2 3" />
        <line x1={cx + r} y1={cy} x2={cx + r} y2={cy + R + 14} stroke-dasharray="2 3" />
        <text x={cx} y={cy + R + 34} text-anchor="middle"><tspan class="lbl">Rin</tspan> {size.rim}″ = {fmt(d.rimMm, 0)} mm</text>
      </g>
      <g class="dim amber">
        <circle cx={px} cy={py} r="3" fill="#c27700" />
        <polyline points={`${px},${py} ${cx + R + 4},${cy - R + 8} 276,${cy - R + 8}`} fill="none" />
        <text x="276" y={cy - R + 2} text-anchor="end"><tspan class="lbl">Flanco</tspan> {fmt(d.sidewall, 0)} mm</text>
      </g>
    </svg>

    <svg viewBox="0 0 180 190" role="img" aria-label={`Corte de la llanta ${sizeLabel(size)}: ancho ${size.width} mm, flanco ${fmt(d.sidewall)} mm, ${size.aspect} % del ancho`}>
      <text class="title" x="90" y="14" text-anchor="middle">Corte</text>
      <g class="dim blue">
        <line x1={sx} y1={sy - 14} x2={sx + w} y2={sy - 14} />
        <line x1={sx} y1={sy - 20} x2={sx} y2={sy - 8} />
        <line x1={sx + w} y1={sy - 20} x2={sx + w} y2={sy - 8} />
        <text x={sx + w / 2} y={sy - 26} text-anchor="middle"><tspan class="lbl">Ancho</tspan> {size.width} mm</text>
      </g>
      <path d={`M${sx} ${sy + 6} Q${sx} ${sy} ${sx + 6} ${sy} H${sx + w - 6} Q${sx + w} ${sy} ${sx + w} ${sy + 6} V${sy + h} H${sx + w - 7} V${sy + 9} H${sx + 7} V${sy + h} H${sx} Z`} fill="#1d232c" />
      <path d={`M${sx} ${sy + 6} V${sy + h} H${sx + 7} V${sy + 9} Z`} fill="#f5a524" fill-opacity="0.55" />
      <path d={`M${sx + w} ${sy + 6} V${sy + h} H${sx + w - 7} V${sy + 9} Z`} fill="#f5a524" fill-opacity="0.55" />
      <rect x={sx - 5} y={sy + h} width={w + 10} height="12" rx="3" fill="#d5dde7" stroke="#8fa0b5" />
      <text class="small" x={sx + w / 2} y={sy + h + 26} text-anchor="middle">rin</text>
      <g class="dim amber">
        <line x1={sx + w + 12} y1={sy} x2={sx + w + 12} y2={sy + h} />
        <line x1={sx + w + 6} y1={sy} x2={sx + w + 18} y2={sy} />
        <line x1={sx + w + 6} y1={sy + h} x2={sx + w + 18} y2={sy + h} />
        <text x={sx + w + 22} y={sy + h / 2 - 3}><tspan class="lbl">Flanco</tspan></text>
        <text x={sx + w + 22} y={sy + h / 2 + 12}>{fmt(d.sidewall, 0)} mm</text>
      </g>
      <text class="small" x="90" y={sy + h + 52} text-anchor="middle">Flanco = {size.aspect} % del ancho</text>
      <text class="small" x="90" y={sy + h + 68} text-anchor="middle">({size.width} × {size.aspect} / 100)</text>
    </svg>
  </div>
  <figcaption>
    <span><i class="k blue"></i>Diámetro total y ancho</span>
    <span><i class="k amber"></i>Flanco: goma entre el rin y la banda de rodamiento</span>
    <span><i class="k grey"></i>Rin (aro)</span>
    <span class="muted">Dibujo a escala de {sizeLabel(size)}.</span>
  </figcaption>
</figure>

<style>
  .td { margin: 1.25rem 0; padding: 0.75rem 0.75rem 0.9rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .views { display: grid; grid-template-columns: 1.65fr 1fr; gap: 0.5rem; align-items: start; }
  .views svg { display: block; width: 100%; height: auto; }
  @media (max-width: 34rem) { .views { grid-template-columns: 1fr; } .views svg + svg { max-width: 15rem; margin: 0 auto; border-top: 1px solid var(--line); padding-top: 0.5rem; } }
  .dim line, .dim polyline { stroke-width: 1.5; }
  .dim text { font: 600 12px system-ui, sans-serif; }
  .dim .lbl { font-weight: 800; }
  .blue line { stroke: var(--accent); } .blue text { fill: var(--accent); }
  .amber line, .amber polyline { stroke: #c27700; } .amber text { fill: #9a5f00; }
  .grey line { stroke: #6d7e93; } .grey text { fill: #4d5b6d; }
  .title { fill: var(--ink); font: 800 13px var(--head); }
  .small { fill: var(--muted); font: 600 11px system-ui, sans-serif; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.85rem; color: var(--ink); margin-top: 0.5rem; }
  figcaption span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .k { width: 0.8rem; height: 0.8rem; border-radius: 3px; flex: none; }
  .k.blue { background: var(--accent); } .k.amber { background: #f5a524; } .k.grey { background: #8fa0b5; }
  .spin { animation: spin 18s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spin { animation: none; } }
</style>
