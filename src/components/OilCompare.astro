---
// Compare two oil grades: tap a grade on each "roller"; drain tubes show how each flows cold and hot.
// Drain speed is derived from SAE J300: cold from the W grade test temperature, hot from the mid
// kinematic viscosity at 100 °C. It is an illustration of "thicker / thinner", not a lab measurement.
import { getCollection } from 'astro:content';
import { parseGrade, gradeSlug } from '../lib/oils.js';

interface Props { a?: string; b?: string; title?: string }
const { a = '5W-30', b = '10W-40', title = 'Compara dos aceites' } = Astro.props;
const GRADES = ['0W-20', '0W-30', '5W-20', '5W-30', '5W-40', '10W-30', '10W-40', '15W-40', '20W-50'];
// What engine makers typically specify each grade for. General orientation only; the manual decides.
const TYPICAL: Record<string, string> = {
  '0W-20': 'Suelen pedirlo muchos autos de gasolina recientes e híbridos, sobre todo japoneses, coreanos y estadounidenses.',
  '0W-30': 'Lo piden algunos autos modernos, sobre todo europeos. Fluye muy bien en frío.',
  '5W-20': 'Habitual en autos de gasolina estadounidenses y japoneses de los años 2000 y 2010.',
  '5W-30': 'Muy común en autos de gasolina y diésel ligeros desde los años 2000.',
  '5W-40': 'Frecuente en autos europeos de gasolina y diésel.',
  '10W-30': 'Motores de gasolina más antiguos y algunos motores pequeños o de trabajo.',
  '10W-40': 'Motores de gasolina más antiguos y muchas motos (con JASO MA si tienen embrague húmedo).',
  '15W-40': 'Motores diésel de trabajo: camiones, camionetas y maquinaria.',
  '20W-50': 'Motores antiguos, climas cálidos y algunas motos grandes.',
};
const pages = new Set((await getCollection('oils')).map((o) => o.id));
const data = Object.fromEntries(GRADES.map((g) => {
  const p = parseGrade(g)!;
  return [g, { w: p.winter, h: p.hot, t: TYPICAL[g], page: pages.has(gradeSlug(p)) ? `/aceite/${gradeSlug(p)}/` : '' }];
}));
const sides = [{ key: 'a', label: 'Aceite A', value: a }, { key: 'b', label: 'Aceite B', value: b }];
---
<section class="ocmp" data-oil-compare aria-label={title}>
  <h2 class="ocmp-title">{title}</h2>
  <div class="ocmp-grid">
    {sides.map((s) => (
      <div class="side" data-side={s.key}>
        <p class="side-label">{s.label}</p>
        <div class="roller" role="radiogroup" aria-label={s.label}>
          {GRADES.map((g) => <button type="button" role="radio" aria-checked={g === s.value ? 'true' : 'false'} data-grade={g}>{g}</button>)}
        </div>
        <div class="tubes" aria-hidden="true">
          <div class="tw"><div class="tube cold"><div class="oil"></div></div><span>❄ Frío</span></div>
          <div class="tw"><div class="tube hot"><div class="oil"></div></div><span>Caliente</span></div>
          <div class="big" data-big>{s.value}</div>
        </div>
        <p class="typ" data-typ></p>
        <a class="go" data-go href="#" hidden>Ver {s.value} →</a>
      </div>
    ))}
  </div>
  <p class="ocmp-out" data-out aria-live="polite"></p>
  <p class="ocmp-note">La animación muestra qué aceite es más fluido o más espeso según la norma SAE J300; no es una medición de laboratorio. El aceite correcto para tu motor es el que indica el manual.</p>
  <script type="application/json" set:html={JSON.stringify(data)} />
</section>

<script>
  type G = { w: number; h: number; t: string; page: string };
  const KV_MID: Record<number, number> = { 20: 8.1, 30: 10.9, 40: 14.4, 50: 19.1, 60: 24 };
  document.querySelectorAll<HTMLElement>('[data-oil-compare]').forEach((root) => {
    const data: Record<string, G> = JSON.parse(root.querySelector('script[type="application/json"]')!.textContent || '{}');
    const state: Record<string, string> = {};
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    root.querySelectorAll<HTMLElement>('.side').forEach((side) => {
      const key = side.dataset.side!;
      const checked = side.querySelector<HTMLElement>('[aria-checked="true"]');
      state[key] = checked?.dataset.grade || '5W-30';
      checked?.scrollIntoView({ block: 'nearest', inline: 'center' });
      side.querySelector('.roller')!.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-grade]');
        if (!btn) return;
        side.querySelectorAll('[data-grade]').forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        state[key] = btn.dataset.grade!;
        render();
      });
    });
    function paint(key: string) {
      const side = root.querySelector<HTMLElement>(`[data-side="${key}"]`)!;
      const g = data[state[key]];
      // Seconds to drain: thicker oil drains slower. Cold scales with the W number, hot with KV at 100 °C.
      const cold = 1.2 + g.w * 0.16;
      const hot = 0.4 + KV_MID[g.h] * 0.12;
      const set = (sel: string, s: number) => {
        const el = side.querySelector<HTMLElement>(sel)!;
        el.style.animation = 'none'; void el.offsetWidth;
        el.style.animation = `drain ${s.toFixed(2)}s ease-in infinite`;
      };
      set('.cold .oil', cold);
      set('.hot .oil', hot);
      side.querySelector('[data-big]')!.textContent = state[key];
      side.querySelector('[data-typ]')!.textContent = g.t;
      const go = side.querySelector<HTMLAnchorElement>('[data-go]')!;
      go.hidden = !g.page; if (g.page) { go.href = g.page; go.textContent = `Ver ${state[key]} →`; }
      return g;
    }
    function render() {
      const A = paint('a'); const B = paint('b');
      const a = state.a; const b = state.b;
      if (a === b) { out.textContent = 'Elige dos aceites distintos para compararlos.'; return; }
      const cold = A.w === B.w ? `En frío fluyen igual (${A.w}W).` : `En frío fluye mejor ${A.w < B.w ? a : b}.`;
      const hot = A.h === B.h ? `Con el motor caliente son igual de espesos (SAE ${A.h}).` : `Con el motor caliente es más espeso ${A.h > B.h ? a : b}.`;
      out.textContent = `${cold} ${hot}`;
    }
    render();
  });
</script>

<style>
  .ocmp { margin: 1.5rem 0; padding: 1rem 1.1rem; border-radius: var(--radius); background: linear-gradient(160deg, #16304f, #0b1a2c); color: #fff; }
  .ocmp-title { margin: 0 0 0.75rem; color: #fff; font-size: 1.3rem; }
  .ocmp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .side { min-width: 0; }
  .side-label { margin: 0 0 0.35rem; font-weight: 700; color: var(--amber-bright); }
  .roller { display: flex; gap: 0.35rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.25rem 0.1rem 0.5rem; scrollbar-width: none; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .roller::-webkit-scrollbar { display: none; }
  .roller button { flex: none; scroll-snap-align: center; min-height: 2.6rem; padding: 0 0.75rem; border: 0; border-radius: 999px; background: rgb(255 255 255 / 10%); color: #d6dfeb; font: 700 0.95rem var(--head); cursor: pointer; transition: background 0.15s, color 0.15s, transform 0.15s; }
  .roller button[aria-checked='true'] { background: var(--amber-bright); color: var(--navy-dark); transform: scale(1.06); }
  .tubes { position: relative; display: flex; gap: 0.6rem; align-items: flex-end; justify-content: center; height: 10rem; margin: 0.5rem 0; padding-right: 4.5rem; }
  .tube { position: relative; width: 2.4rem; height: 8rem; border-radius: 0 0 1.2rem 1.2rem; border: 2px solid rgb(255 255 255 / 55%); border-top: 0; overflow: hidden; background: rgb(255 255 255 / 5%); }
  .tube.cold { box-shadow: inset 0 0 0 3px rgb(124 196 255 / 25%); }
  .tube.hot { box-shadow: inset 0 0 0 3px rgb(255 140 60 / 25%); }
  .tw { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .tw span { font-size: 0.72rem; color: #b9c6d8; white-space: nowrap; }
  .oil { position: absolute; left: 0; right: 0; bottom: 0; height: 100%; background: linear-gradient(180deg, #ffd27a, #c77800); transform-origin: bottom; }
  .big { position: absolute; right: 0; top: 50%; transform: translateY(-50%); font: 800 1.3rem var(--head); color: #fff; writing-mode: horizontal-tb; }
  .typ { font-size: 0.9rem; line-height: 1.4; color: #d6dfeb; margin: 0 0 0.3rem; min-height: 3.8em; }
  .go { color: var(--amber-bright); font-weight: 700; text-decoration: none; font-size: 0.9rem; }
  .ocmp-out { margin: 0.75rem 0 0.4rem; padding: 0.7rem 0.9rem; border-radius: 10px; background: rgb(255 255 255 / 10%); font-weight: 600; }
  .ocmp-note { margin: 0; font-size: 0.8rem; color: #9fb3cc; }
  @keyframes drain { 0% { transform: scaleY(1); } 80% { transform: scaleY(0.04); } 100% { transform: scaleY(0.04); } }
  @media (max-width: 34rem) { .tubes { padding-right: 0; height: 9rem; } .tube { width: 2rem; height: 7rem; } .big { display: none; } }
  @media (prefers-reduced-motion: reduce) { .oil { animation: none !important; } }
</style>
