---
// Simplified dashboard symbols drawn for Tallerpedia (inspired by the ISO 2575 pictograms, not copies of a brand's artwork).
interface Props { name: string; size?: number; color?: 'rojo' | 'amarillo' | 'mixto' }
const { name, size = 56, color = 'amarillo' } = Astro.props;
const paths: Record<string, string> = {
  engine: '<path d="M2.5 10.5v5M2.5 13h2.2M4.7 9.5h2V8h2.8V6.5h5V8h2.2l1.8 2h1.4V9h1.6v8h-1.6v-1.5h-1.4l-2.2 2.5H8.5L6.7 16H4.7z"/>',
  oil: '<path d="M2 10.5h3.5l2-1.5h6l1.5 1L21 8l-6.5 7.5H8.5L6.5 13.5H2z"/><path d="M10.5 9V7.2M8.8 7h3.4"/><path d="M21.5 13.2c0 .9-.6 1.6-1.3 1.6s-1.3-.7-1.3-1.6c0-.8 1.3-2.4 1.3-2.4s1.3 1.6 1.3 2.4z"/>',
  tpms: '<path d="M7 19.5a8.2 8.2 0 0 1-2.4-11.3L6.2 5.5h11.6l1.6 2.7A8.2 8.2 0 0 1 17 19.5"/><path d="M5 20.5h1.6M9 20.5h1.4M13.6 20.5H15M17.4 20.5H19"/><path d="M12 8.5v5.5"/><circle cx="12" cy="16.8" r=".4" fill="currentColor"/>',
  battery: '<rect x="2.5" y="7" width="19" height="12" rx="1.5"/><path d="M5.5 7V5h3v2M15.5 7V5h3v2M5.5 13h4M15 13h4M17 11v4"/>',
  temp: '<path d="M12 3.5v10"/><path d="M12 3.5h3M12 6.5h3M12 9.5h3"/><circle cx="12" cy="15.5" r="2"/><path d="M3 19.5c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0"/>',
  brake: '<circle cx="12" cy="12" r="6.5"/><path d="M5 5.5a9.5 9.5 0 0 0 0 13M19 5.5a9.5 9.5 0 0 1 0 13"/><path d="M12 8.5v4.5"/><circle cx="12" cy="15.6" r=".4" fill="currentColor"/>',
  amber: '<path d="M12 3.5 21.5 20h-19z"/><path d="M12 10v4.5"/><circle cx="12" cy="17.2" r=".4" fill="currentColor"/>',
  red: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5"/><circle cx="12" cy="16.3" r=".4" fill="currentColor"/>',
};
const tone = color === 'rojo' ? 'sym-red' : color === 'amarillo' ? 'sym-amber' : 'sym-mixed';
---
<span class={`sym ${tone}`} style={`--s:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width={Math.round(size * 0.62)} height={Math.round(size * 0.62)} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={paths[name] ?? paths.amber} />
</span>
<style>
  .sym { display: inline-grid; place-items: center; flex: none; width: var(--s); height: var(--s); border-radius: 12px; background: #11161d; }
  .sym-amber { color: #ffb020; }
  .sym-red { color: #ff4d3d; }
  .sym-mixed { color: #ffb020; box-shadow: inset 0 -4px 0 #ff4d3d; }
</style>
