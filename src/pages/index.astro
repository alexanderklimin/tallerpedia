---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Symbol from '../components/Symbol.astro';
import Dashboard from '../components/Dashboard.astro';
import CodeSearch from '../components/CodeSearch.astro';
import TirePicker from '../components/TirePicker.astro';
import published from '../data/tires/published.json';
import { parseSize, sizeLabel, sizePath, dimensions } from '../lib/tires.js';
import { fmt } from '../lib/format.js';
import { codePath, SEVERITY } from '../data/systems.js';
import { SITE_NAME } from '../data/site.js';

const lights = (await getCollection('lights')).sort((a, b) => a.data.order - b.data.order);
const oils = (await getCollection('oils')).sort((a, b) => a.data.order - b.data.order);
const codes = (await getCollection('codes')).sort((a, b) => a.data.code.localeCompare(b.data.code));
const topCodes = ['P0420', 'P0171', 'P0300', 'P0455', 'P0128', 'P0340'].map((c) => codes.find((e) => e.data.code === c)!).filter(Boolean);
const topSizes = published.slice(0, 8).map((s) => parseSize(s.replace(/-/g, ' '))!);
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: Astro.site?.href, inLanguage: 'es' }];
const entries = [
  { href: '/testigos/', icon: 'triangle-alert', t: 'Se encendió una luz', s: 'Qué significa cada testigo y si puedes seguir.' },
  { href: '/codigos-obd/', icon: 'scan-line', t: 'El escáner me dio un código', s: 'Causas, diagnóstico y gravedad.' },
  { href: '/llantas/', icon: 'circle-dot', t: 'Voy a cambiar llantas', s: 'Medidas, equivalencias y velocímetro.' },
  { href: '/aceite/', icon: 'droplet', t: '¿Qué aceite le pongo?', s: 'Viscosidades y especificaciones.' },
];
---
<Base title="Tallerpedia: códigos OBD, llantas y guía práctica para tu auto" description="Qué significa cada código OBD y cada luz del tablero, medidas y equivalencias de llantas y qué aceite usar, explicado en español y con la seguridad primero." jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-in">
      <div class="hero-text">
        <p class="kicker">Guía práctica para tu auto</p>
        <h1>Entiende qué le pasa a tu auto</h1>
        <p class="hero-lead">Códigos de falla, luces del tablero, llantas y aceite. Explicado claro, con fuentes y la seguridad primero.</p>
        <CodeSearch title="¿Qué código te salió?" compact />
      </div>
      <div class="hero-art"><Dashboard /></div>
    </div>
  </section>

  <h2 class="sr-title">¿Qué te pasa?</h2>
  <ul class="entries">
    {entries.map((e) => (
      <li><a href={e.href}><span class="ic"><Icon name={e.icon as never} size={22} /></span><strong>{e.t}</strong><span>{e.s}</span></a></li>
    ))}
  </ul>

  <h2>Códigos más consultados</h2>
  <ul class="tile-grid">
    {topCodes.map((c) => <li><a class="tile code-tile" href={codePath(c.data.code)}><strong class="mono">{c.data.code}</strong><span>{c.data.title}</span><em class={`sev-dot ${c.data.severity}`}>{SEVERITY[c.data.severity].label}</em></a></li>)}
  </ul>
  <p class="more"><a href="/codigos-obd/">Todos los códigos <Icon name="arrow-right" size={16} /></a></p>

  <h2>Luces del tablero</h2>
  <ul class="tile-grid">
    {lights.map((l) => <li><a class="tile lt" href={`/testigos/${l.id}/`}><Symbol name={l.data.symbol} color={l.data.color} size={44} /><div><strong>{l.data.name}</strong><span>{l.data.short}</span></div></a></li>)}
  </ul>

  <h2>Medidas de llantas</h2>
  <div class="tp-wrap"><TirePicker /></div>
  <ul class="tile-grid">
    {topSizes.map((s) => <li><a class="tile" href={sizePath(s)}><strong>{sizeLabel(s)}</strong><span>Rin {s.rim} · {fmt(dimensions(s).diameter, 0)} mm de diámetro</span></a></li>)}
  </ul>
  <p class="more"><a href="/llantas/">Todas las medidas <Icon name="arrow-right" size={16} /></a> · <a href="/herramientas/equivalencia-de-llantas/">Calculadora de equivalencias</a></p>

  <h2>Aceite de motor</h2>
  <ul class="tile-grid">
    {oils.map((o) => <li><a class="tile" href={`/aceite/${o.id}/`}><strong>{o.data.grade ?? o.data.name}</strong><span>{o.data.short}</span></a></li>)}
  </ul>

  <div class="alert" role="note">
    <Icon name="shield-alert" size={24} />
    <div>
      <strong>Si falla algo de seguridad, no conduzcas</strong>
      <p>Frenos que no responden, dirección dura o con juego, temperatura en rojo, olor a gasolina o la luz de check engine parpadeando: detente en un lugar seguro y acude a un taller o pide una grúa.</p>
    </div>
  </div>
</Base>

<style>
  .hero { position: relative; isolation: isolate; margin-top: -1rem; padding: 1.5rem 0 2rem; color: #fff; }
  .hero::before { content: ''; position: absolute; z-index: -1; inset-block: 0; left: 50%; width: 100vw; transform: translateX(-50%); background: radial-gradient(120% 90% at 85% 10%, #234a78 0%, transparent 55%), linear-gradient(160deg, #16304f 0%, #0b1a2c 70%); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); gap: 2.5rem; align-items: center; }
  @media (max-width: 52rem) { .hero-in { grid-template-columns: 1fr; gap: 0.5rem; } .hero-art { max-width: 15rem; margin-inline: auto; width: 100%; opacity: 0.9; } }
  .kicker { margin: 0; color: var(--amber-bright); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.8rem; }
  .hero h1 { color: #fff; max-width: 16ch; margin-top: 0.3rem; }
  .hero-lead { font-size: 1.15rem; color: #dbe4ef; max-width: 36rem; }
  .hero :global(.cs) { background: rgb(255 255 255 / 7%); border: 1px solid rgb(255 255 255 / 12%); box-shadow: none; margin: 1.25rem 0 0.75rem; }
  .sr-title { margin-top: 2rem; }
  .entries { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  @media (max-width: 36rem) { .entries { grid-template-columns: 1fr 1fr; gap: 0.5rem; } .entries a { padding: 0.8rem; } .entries strong { font-size: 1rem; } .entries span:last-child { font-size: 0.85rem; } }
  .entries a { display: flex; flex-direction: column; gap: 0.2rem; height: 100%; padding: 1rem 1.1rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); color: var(--ink); text-decoration: none; box-shadow: 0 1px 2px rgb(14 33 56 / 4%); transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease; }
  .entries a:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgb(14 33 56 / 10%); border-color: transparent; }
  .entries .ic { display: inline-grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 12px; background: var(--navy); color: var(--amber-bright); margin-bottom: 0.4rem; }
  .entries strong { font-family: var(--head); font-size: 1.15rem; }
  .entries span:last-child { color: var(--muted); font-size: 0.95rem; }
  .tile.lt { flex-direction: row; align-items: center; gap: 0.75rem; }
  .tile.lt div { display: flex; flex-direction: column; }
  .code-tile strong { color: var(--navy); }
  .sev-dot { font-style: normal; font-size: 0.8rem; font-weight: 700; margin-top: 0.35rem; display: inline-flex; align-items: center; gap: 0.35rem; }
  .sev-dot::before { content: ''; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: currentColor; }
  .sev-dot.low { color: var(--green); } .sev-dot.medium { color: var(--amber); } .sev-dot.high { color: var(--red); }
  .more { margin-top: 0.75rem; }
  .tp-wrap { max-width: 38rem; padding: 0.25rem; border-radius: calc(var(--radius) + 4px); background: linear-gradient(160deg, #16304f, #0b1a2c); }
  @media (prefers-reduced-motion: reduce) { .entries a { transition: none; } }
</style>
