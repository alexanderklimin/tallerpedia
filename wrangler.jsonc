{
  // Статический сайт на Cloudflare Workers (static assets). Сборка: npm run build → dist/
  // Запущен 2026-11-21 (явное «да» пользователя): домен tallerpedia.com, workers.dev отключён.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tallerpedia",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "tallerpedia.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
